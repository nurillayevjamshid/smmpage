# DAILY cloud infrastructure (server-side only; never commit real values)
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=
STORAGE_BUCKET=daily-private-media
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
REDIS_URL=
SYNC_EVENT_RETENTION_DAYS=30
MEDIA_MAX_UPLOAD_BYTES=52428800
SIGNED_URL_TTL_SECONDS=300
# DAILY WebRTC signaling (server-side configuration; never commit real values)
WEBRTC_STUN_URL=stun:stun.example.com:3478
WEBRTC_TURN_URL=turn:turn.example.com:3478
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CALL_SIGNALING_SESSION_TTL_SECONDS=300
CALL_MAX_PARTICIPANTS=50
CALL_RING_RATE_LIMIT_PER_MINUTE=10
# DAILY Mini App / Developer Platform (server-side only)
MINI_APP_SDK_VERSION=1.0
MINI_APP_SIGNING_KEY=
MINI_APP_ALLOWED_ORIGINS=
DEVELOPER_API_KEY_HASH_SALT=
BOT_WEBHOOK_SIGNING_SECRET=
MINI_APP_PAYMENT_CALLBACK_TTL_SECONDS=300
DEVELOPER_API_RATE_LIMIT_PER_MINUTE=120
# DAILY Marketplace (server-side only)
MARKETPLACE_SEARCH_PROVIDER=postgres-full-text
MARKETPLACE_INVENTORY_LOCK_TIMEOUT_MS=3000
MARKETPLACE_ORDER_EVENT_QUEUE=
MARKETPLACE_DELIVERY_PROVIDER=
MARKETPLACE_COUPON_SIGNING_KEY=
MARKETPLACE_REVIEW_RATE_LIMIT_PER_HOUR=10
# DAILY Content / Recommendation (server-side only)
CONTENT_MEDIA_CDN_URL=
CONTENT_VIDEO_TRANSCODER_QUEUE=
CONTENT_VIEW_EVENT_QUEUE=
CONTENT_RECOMMENDATION_PROVIDER=rule-based
CONTENT_RECOMMENDATION_CACHE_TTL_SECONDS=300
CONTENT_MODERATION_PROVIDER=
CONTENT_TRENDING_WINDOW_HOURS=24
# DAILY Security (server-side only; use managed secrets)
SECURITY_E2EE_PROTOCOL=signal-protocol-audited-library
SECURITY_KEY_SERVICE=
SECURITY_SESSION_TTL_SECONDS=2592000
SECURITY_REFRESH_ROTATION=true
SECURITY_RATE_LIMIT_STORE=redis
SECURITY_AUDIT_LOG_SINK=
SECURITY_FRAUD_RISK_PROVIDER=
SECURITY_UPLOAD_SCAN_PROVIDER=
# DAILY Monetization (server-side only; mock provider may be used in development)
MONETIZATION_PROVIDER=mock
SUBSCRIPTION_WEBHOOK_SIGNING_SECRET=
COIN_LEDGER_DATABASE_URL=
PAYOUT_PROVIDER=
PAYOUT_MINIMUM_AMOUNT=100000
ADS_AUCTION_PROVIDER=
ADS_INVALID_CLICK_QUEUE=
REFERRAL_FRAUD_PROVIDER=
PLATFORM_COMMISSION_BPS=1500
# DAILY Personal AI (server-side only)
AI_PROVIDER=mock
AI_MODEL=
AI_USAGE_LIMIT_STORE=redis
AI_MEMORY_STORE=
AI_TOOL_AUDIT_SINK=
AI_VOICE_STT_PROVIDER=
